{
  "name": "stream-deck-sounds-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c && node scripts/vendor-koffi.mjs",
    "deploy": "rollup -c && node scripts/deploy.mjs",
    "watch": "rollup -c -w --watch.onEnd=\"node scripts/deploy.mjs\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate de.atacama-blooms.soundboard.sdPlugin",
    "pack": "npm run build && streamdeck pack de.atacama-blooms.soundboard.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "koffi": "^3.3.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.4",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
